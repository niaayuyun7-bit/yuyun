<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Game Klik Target</title>
  <style>
    * {
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      margin: 0;
      background: linear-gradient(135deg, #1e3c72, #2a5298);
      color: white;
      text-align: center;
      padding: 20px;
    }

    .container {
      max-width: 420px;
      margin: auto;
    }

    h1 {
      margin-bottom: 10px;
    }

    .info {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin: 15px 0;
      flex-wrap: wrap;
    }

    .card {
      flex: 1;
      min-width: 100px;
      background: rgba(255,255,255,0.15);
      padding: 10px;
      border-radius: 12px;
    }

    #startBtn {
      background: #00c853;
      color: white;
      border: none;
      padding: 12px 20px;
      font-size: 16px;
      border-radius: 12px;
      cursor: pointer;
      margin-bottom: 15px;
      touch-action: manipulation;
    }

    #gameArea {
      position: relative;
      width: 100%;
      height: 420px;
      background: rgba(255,255,255,0.12);
      border: 2px solid rgba(255,255,255,0.25);
      border-radius: 18px;
      overflow: hidden;
      margin-top: 10px;
    }

    #target {
      position: absolute;
      width: 70px;
      height: 70px;
      border: none;
      border-radius: 50%;
      background: #ff5252;
      color: white;
      font-size: 24px;
      font-weight: bold;
      display: none;
      cursor: pointer;
      box-shadow: 0 6px 16px rgba(0,0,0,0.3);
      touch-action: manipulation;
    }

    #message {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      font-size: 20px;
      color: #fff;
    }

    .small {
      font-size: 14px;
      opacity: 0.9;
      margin-top: 10px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>🎯 Game Klik Target</h1>
    <p>Klik lingkaran merah sebanyak mungkin dalam 30 detik.</p>

    <div class="info">
      <div class="card">Skor<br><strong id="score">0</strong></div>
      <div class="card">Waktu<br><strong id="time">30</strong></div>
      <div class="card">Rekor<br><strong id="best">0</strong></div>
    </div>

    <button id="startBtn">Mulai Game</button>

    <div id="gameArea">
      <button id="target">+</button>
      <div id="message">Tekan "Mulai Game"</div>
    </div>

    <p class="small">Game ini dibuat dengan HTML, CSS, dan JavaScript lalu di-host di GitHub Pages.</p>
  </div>

  <script>
    const scoreEl = document.getElementById("score");
    const timeEl = document.getElementById("time");
    const bestEl = document.getElementById("best");
    const startBtn = document.getElementById("startBtn");
    const target = document.getElementById("target");
    const gameArea = document.getElementById("gameArea");
    const message = document.getElementById("message");

    let score = 0;
    let timeLeft = 30;
    let gameRunning = false;
    let timer = null;

    const bestKey = "gameKlikTargetBest";
    bestEl.textContent = localStorage.getItem(bestKey) || 0;

    function moveTarget() {
      const areaWidth = gameArea.clientWidth;
      const areaHeight = gameArea.clientHeight;
      const targetSize = 70;

      const maxX = areaWidth - targetSize;
      const maxY = areaHeight - targetSize;

      const x = Math.floor(Math.random() * maxX);
      const y = Math.floor(Math.random() * maxY);

      target.style.left = x + "px";
      target.style.top = y + "px";
    }

    function startGame() {
      score = 0;
      timeLeft = 30;
      gameRunning = true;

      scoreEl.textContent = score;
      timeEl.textContent = timeLeft;

      target.style.display = "block";
      message.style.display = "none";
      startBtn.disabled = true;
      startBtn.textContent = "Game Berjalan...";

      moveTarget();

      timer = setInterval(() => {
        timeLeft--;
        timeEl.textContent = timeLeft;

        if (timeLeft <= 0) {
          endGame();
        }
      }, 1000);
    }

    function endGame() {
      clearInterval(timer);
      gameRunning = false;
      target.style.display = "none";
      message.style.display = "flex";

      let best = Number(localStorage.getItem(bestKey) || 0);
      if (score > best) {
        best = score;
        localStorage.setItem(bestKey, best);
      }
      bestEl.textContent = best;

      message.innerHTML = `Game selesai!<br>Skor kamu: <strong>${score}</strong>`;
      startBtn.disabled = false;
      startBtn.textContent = "Main Lagi";
    }

    function hitTarget() {
      if (!gameRunning) return;
      score++;
      scoreEl.textContent = score;
      moveTarget();
    }

    startBtn.addEventListener("click", startGame);
    target.addEventListener("click", hitTarget);
    target.addEventListener("touchstart", function(e) {
      e.preventDefault();
      hitTarget();
    }, { passive: false });
  </script>
</body>
